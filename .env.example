# Copy to .env.local and fill in. Set the same values in Vercel under
# Settings -> Environment Variables before deploying.

# --- Database (Neon or Supabase — use the POOLED connection string) --------
DATABASE_URL=

# --- Email provider (pick one) ----------------------------------------------
MAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# BREVO_API_KEY=

MAIL_FROM="Amplify 850 <news@amplify850.org>"
# CAN-SPAM requires a real postal address in every send.
MAIL_POSTAL_ADDRESS="Amplify 850, 222 S Copeland St, Tallahassee, FL 32306"
# Safety margin under the provider's daily cap (Resend free tier = 100/day).
MAIL_DAILY_CAP=85

# --- Site ---------------------------------------------------------------------
SITE_URL=https://www.amplify850.org
NEXT_PUBLIC_SITE_URL=https://www.amplify850.org

# --- Secrets — generate with the commands below, keep these private ----------
# openssl rand -hex 32
ADMIN_SECRET=
# openssl rand -hex 32
CRON_SECRET=
# openssl rand -hex 16
IP_HASH_SALT=
